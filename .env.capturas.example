# Copia este archivo como .env.capturas (no se sube a Git) y complétalo.
# Usa SIEMPRE un usuario de una empresa de DEMOSTRACIÓN, con datos ficticios.

# Dirección del ambiente demo o staging, sin barra al final.
INVENTY_DEMO_URL=https://demo.inventy.co

# Usuario demo (idealmente con rol Administrador para ver todos los menús).
INVENTY_DEMO_EMAIL=demo@inventy.co
INVENTY_DEMO_PASSWORD=

# Opcional: identificador de la empresa en la URL (/{empresa}/...). Si se deja
# vacío, se toma de la URL a la que llega el usuario después de iniciar sesión.
INVENTY_DEMO_TENANT=
